# Hy3 / 混元3 via Tencent Cloud TokenHub
# 控制台路径：API 接入 → Chat Completions API → Python 示例
# 若控制台示例中的 base_url 或 model 与此处不同，请以控制台为准
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_API_KEY=
HY3_MODEL=hy3

# Generation settings
# 默认不发送采样参数，保持与 TokenHub 官方 curl 示例一致；
# 若你的部署明确支持 temperature/top_p，可设 HY3_SEND_SAMPLING_PARAMS=1。
HY3_SEND_SAMPLING_PARAMS=0
HY3_TEMPERATURE=0.2
HY3_TOP_P=1.0
HY3_TIMEOUT_SECONDS=120

# Optional: supported by some Hy3 deployments
HY3_REASONING_EFFORT=high
